    { "src": "screenshots/narrow-2.png", "sizes": "1080x1920", "type": "image/png", "form_factor": "narrow", "label": "Site photos with work descriptions, floor and trade" },
    { "src": "screenshots/narrow-3.png", "sizes": "1080x1920", "type": "image/png", "form_factor": "narrow", "label": "Activity progress entered by percentage on site" },
