{
  "id": "./",
  "name": "HIDECOR SiteLog — Daily Progress Report",
  "short_name": "SiteLog",
  "description": "Capture site photographs with work descriptions, daily progress, manpower, approvals and tomorrow's plan on site, then issue the Daily Progress Report as a PDF. Built for interior fit-out and MEP projects. Works fully offline.",
